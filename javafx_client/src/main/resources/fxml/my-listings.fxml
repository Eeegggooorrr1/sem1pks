<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<fx:root type="BorderPane"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>
    <top>
        <TitledPane text="Новое объявление" expanded="false">
            <padding>
                <Insets bottom="14"/>
            </padding>
            <content>
                <GridPane hgap="10" vgap="10">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Название" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="title" promptText="Название"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Описание" styleClass="form-label-top" GridPane.valignment="TOP"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextArea fx:id="description" promptText="Описание" prefRowCount="3"
                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Цена" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="price" promptText="Цена"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Категория" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="category" maxWidth="Infinity"
                              GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Button fx:id="createButton" text="Создать объявление" styleClass="primary-button"
                            onAction="#create" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>
            </content>
        </TitledPane>
    </top>
    <center>
        <ListView fx:id="listings" styleClass="content-list">
            <placeholder>
                <Label text="У вас пока нет объявлений"/>
            </placeholder>
        </ListView>
    </center>
</fx:root>
